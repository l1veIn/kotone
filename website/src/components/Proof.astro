---
import { t as i18n } from "../i18n";
import shotWelcome from "../assets/screenshot-welcome.webp";
import shotVoice from "../assets/screenshot-voice.webp";
import shotConfig from "../assets/screenshot-config.webp";
import shotHistory from "../assets/screenshot-history.webp";

const t = i18n(Astro.url.pathname);
const proof = t.proof;
const shots = new Map([
  ["screenshot-welcome.webp", shotWelcome],
  ["screenshot-voice.webp", shotVoice],
  ["screenshot-config.webp", shotConfig],
  ["screenshot-history.webp", shotHistory],
]);
---

<script>
  const overlay = document.getElementById("lightbox");
  const img = document.querySelector<HTMLImageElement>("#lightbox-img");
  const closeBtn = document.getElementById("lightbox-close");
  if (overlay && img && closeBtn) {
    let lastFocus: HTMLElement | null = null;
    document.querySelectorAll<HTMLElement>(".shot-card").forEach((card) => {
      const open = () => {
        const src = card.dataset.full;
        if (!src) return;
        lastFocus = card;
        img.src = src;
        img.alt = card.dataset.label ?? "";
        overlay.inert = false;
        overlay.setAttribute("aria-hidden", "false");
        overlay.classList.add("is-open");
        closeBtn.focus();
      };
      card.addEventListener("click", open);
      card.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          open();
        }
      });
    });
    const close = () => {
      overlay.classList.remove("is-open");
      lastFocus?.focus();
      overlay.inert = true;
      overlay.setAttribute("aria-hidden", "true");
    };
    closeBtn.addEventListener("click", close);
    overlay.addEventListener("click", (event) => {
      if (event.target === overlay) close();
    });
    document.addEventListener("keydown", (event) => {
      if (!overlay.classList.contains("is-open")) return;
      if (event.key === "Escape") close();
      if (event.key === "Tab") {
        event.preventDefault();
        closeBtn.focus();
      }
    });
  }
</script>

<section class="section proof" id="proof">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="kicker">{proof.kicker}</span>
      <h2>{proof.title}</h2>
    </div>

    <div class="proof__grid">
      {proof.items.map((item, i) => {
        const src = shots.get(item.img);
        if (!src) throw new Error(`Unknown gallery image: ${item.img}`);
        return (
          <figure
            class="shot-card"
            data-full={src.src}
            data-label={item.label}
            tabindex="0"
            role="button"
            data-reveal
            style={`--rd:${(i % 2) * 90}ms`}
          >
            <div class="shot-card__img"><img src={src.src} alt={item.label} loading="lazy" /></div>
            <figcaption class="shot-card__cap">{item.label}</figcaption>
          </figure>
        );
      })}
    </div>

    <p class="proof__note">{proof.note}</p>
  </div>
</section>

<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="preview" aria-hidden="true" inert>
  <button id="lightbox-close" class="lightbox__close" aria-label="close">✕</button>
  <img id="lightbox-img" src="" alt="" />
</div>
