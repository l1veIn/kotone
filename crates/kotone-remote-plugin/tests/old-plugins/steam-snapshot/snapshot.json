        "mimeType": "text/html;profile=mcp-app",
        "text": "<!doctype html>\n<html lang=\"zh-CN\" data-display=\"inline\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light dark\">\n<title>Steam 库</title>\n<style>\n/* 颜色、字体照宿主给的变量（MCP Apps 的 hostContext.styles.variables），没给就用下面的 */\n:root {\n  --bg: var(--color-background-primary, #ffffff);\n  --bg2: var(--color-background-secondary, #f4f5f7);\n  --bg3: var(--color-background-tertiary, #e9ebef);\n  --text: var(--color-text-primary, #16181d);\n  --muted: var(--color-text-secondary, #5f6672);\n  --faint: var(--color-text-tertiary, #8a909b);\n  --border: var(--color-border-primary, #e2e5ea);\n  --ring: var(--color-ring-primary, #3a6fd8);\n  --ok: var(--color-text-success, #1f8a4c);\n  --danger: var(--color-text-danger, #c0392b);\n  --radius: var(--border-radius-md, 8px);\n  --radius-lg: var(--border-radius-lg, 12px);\n  --font: var(--font-sans, system-ui, \"Segoe UI\", \"Microsoft YaHei UI\", \"PingFang SC\", sans-serif);\n  --sm: var(--font-text-sm-size, 13px);\n  --md: var(--font-text-md-size, 14px);\n  color-scheme: light;\n}\n:root[data-theme=\"dark\"] {\n  --bg: var(--color-background-primary, #16181d);\n  --bg2: var(--color-background-secondary, #1f2228);\n  --bg3: var(--color-background-tertiary, #2a2e36);\n  --text: var(--color-text-primary, #eceef2);\n  --muted: var(--color-text-secondary, #a4abb6);\n  --faint: var(--color-text-tertiary, #7b828d);\n  --border: var(--color-border-primary, #30343c);\n  --ring: var(--color-ring-primary, #7aa2ff);\n  --ok: var(--color-text-success, #5fd08f);\n  --danger: var(--color-text-danger, #ff7a6b);\n  color-scheme: dark;\n}\n* { box-sizing: border-box; }\nhtml, body { margin: 0; background: var(--bg); color: var(--text); font: var(--md)/1.5 var(--font); }\nbody { padding: 14px 16px 16px; }\nbutton { font: inherit; color: inherit; }\nheader { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 12px; }\nh1 { font-size: 16px; font-weight: 600; margin: 0; }\n.count { color: var(--muted); font-size: var(--sm); }\n.spacer { flex: 1; }\n.seg { display: inline-flex; background: var(--bg2); border-radius: var(--radius); padding: 2px; }\n.seg button { border: 0; background: transparent; padding: 3px 10px; border-radius: calc(var(--radius) - 2px); cursor: pointer; color: var(--muted); font-size: var(--sm); }\n.seg button[aria-pressed=\"true\"] { background: var(--bg); color: var(--text); box-shadow: var(--shadow-hairline, 0 0 0 1px var(--border)); }\n.btn { border: 1px solid var(--border); background: var(--bg); padding: 3px 10px; border-radius: var(--radius); cursor: pointer; font-size: var(--sm); }\n.btn:hover, .row:hover { background: var(--bg2); }\nbutton:focus-visible, input:focus-visible { outline: 2px solid var(--ring); outline-offset: 1px; }\ninput[type=\"search\"] { border: 1px solid var(--border); background: var(--bg); color: var(--text); border-radius: var(--radius); padding: 3px 10px; font: inherit; font-size: var(--sm); width: 160px; }\n.list { display: flex; flex-direction: column; gap: 2px; }\n.row { display: flex; align-items: center; gap: 12px; width: 100%; text-align: left; border: 0; background: transparent; padding: 7px 8px; border-radius: var(--radius); cursor: pointer; }\n.tile { flex: none; width: 34px; height: 34px; border-radius: 8px; display: grid; place-items: center; font-weight: 700; font-size: 15px; color: #fff; }\n.main { min-width: 0; flex: 1; }\n.name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 500; }\n.meta { color: var(--muted); font-size: var(--sm); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.side { flex: none; color: var(--faint); font-size: var(--sm); text-align: right; }\n.more { color: var(--muted); font-size: var(--sm); padding: 6px 8px; }\n.status { color: var(--muted); font-size: var(--sm); padding: 8px; }\n.status.error { color: var(--danger); }\n.detail h2 { font-size: 18px; margin: 0; }\n.sub { color: var(--muted); font-size: var(--sm); margin-top: 2px; word-break: break-all; }\n.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 8px; margin: 14px 0; }\n.stat { background: var(--bg2); border-radius: var(--radius); padding: 8px 10px; }\n.stat .k { color: var(--muted); font-size: 12px; }\n.stat .v { font-weight: 600; margin-top: 2px; }\n.bar { height: 6px; border-radius: 3px; background: var(--bg3); overflow: hidden; margin: 6px 0 10px; }\n.bar > i { display: block; height: 100%; background: var(--ok); }\n.ach { padding: 6px 0; border-top: 1px solid var(--border); }\n.ach .when { color: var(--faint); font-size: 12px; }\n.ach .desc { color: var(--muted); font-size: var(--sm); }\n.top { display: flex; align-items: flex-start; gap: 12px; }\n.top .tile { width: 48px; height: 48px; font-size: 20px; border-radius: 10px; }\n.section { font-weight: 600; margin-top: 4px; }\n.label { color: var(--muted); font-size: 12px; margin-bottom: 2px; }\n</style>\n</head>\n<body>\n<div id=\"app\"><div class=\"status\" id=\"boot\">…</div></div>\n<script>\n\"use strict\";\n// Steam 库（MCP App，规范 2026-01-26）。不引任何库：和宿主说话的那几条 JSON-RPC 自己写（ext-apps 的 App 做的事的一个小子集）。\n// 握手顺序照规范：ui/initialize → 宿主回话 → ui/notifications/initialized，之后宿主才推工具的输入、结果和上下文。\n// 页面不连任何网址；游戏名这些都是从文件里读来的字，一律用 textContent，不拼 HTML。\n(function () {\n  var VERSION = \"0.1.0\";\n  var PROTOCOL = \"2026-01-26\";\n\n  var STRINGS = {\n    zh: {\n      title: \"Steam 库\", count: \"{n} 个游戏\", recent: \"最近玩\", playtime: \"时长\", search: \"搜索\", refresh: \"刷新\",\n      open: \"打开\", back: \"← 返回\", more: \"还有 {n} 个\", loading: \"正在读……\", empty: \"没有装游戏\",\n      noMatch: \"没有名字里有“{q}”的游戏\", standalone: \"这是一个 MCP App 页面，要在支持 MCP Apps 的宿主（Kotone、Claude……）里打开。\",\n      never: \"没玩过\", justNow: \"刚刚\", minAgo: \"{n} 分钟前\", hourAgo: \"{n} 小时前\", yesterday: \"昨天\", dayAgo: \"{n} 天前\",\n      monthAgo: \"{n} 个月前\", yearAgo: \"{n} 年前\", minutes: \"{n} 分钟\", hours: \"{n} 小时\",\n      total: \"总时长\", twoWeeks: \"近两周\", lastPlayed: \"最近玩\", size: \"大小\", updated: \"最后更新\", notInstalled: \"没装\",\n      updating: \"在下载或更新\", achievements: \"成就\", noAch: \"本机没有这个游戏的成就缓存\", noAchAtAll: \"这个游戏没有成就\",\n      unknownTime: \"时间不知道\", recentUnlocked: \"最近解锁\", failed: \"没读到：{e}\"\n    },\n    en: {\n      title: \"Steam library\", count: \"{n} games\", recent: \"Recent\", playtime: \"Playtime\", search: \"Search\", refresh: \"Refresh\",\n      open: \"Open\", back: \"← Back\", more: \"{n} more\", loading: \"Reading…\", empty: \"No games installed\",\n      noMatch: \"No game named “{q}”\", standalone: \"This is an MCP App. Open it in a host that supports MCP Apps (Kotone, Claude…).\",\n      never: \"Never\", justNow: \"just now\", minAgo: \"{n} min ago\", hourAgo: \"{n} h ago\", yesterday: \"yesterday\", dayAgo: \"{n} days ago\",\n      monthAgo: \"{n} months ago\", yearAgo: \"{n} years ago\", minutes: \"{n} min\", hours: \"{n} h\",\n      total: \"Total\", twoWeeks: \"Past 2 weeks\", lastPlayed: \"Last played\", size: \"Size\", updated: \"Updated\", notInstalled: \"Not installed\",\n      updating: \"downloading or updating\", achievements: \"Achievements\", noAch: \"No achievement cache for this game on this PC\",\n      noAchAtAll: \"This game has no achievements\", unknownTime: \"time unknown\", recentUnlocked: \"Recently unlocked\", failed: \"Couldn't read: {e}\"\n    }\n  };\n  var lang = \"zh\";\n  function t(key, vars) {\n    var s = (STRINGS[lang] && STRINGS[lang][key]) || STRINGS.zh[key] || key;\n    if (vars) for (var k in vars) s = s.split(\"{\" + k + \"}\").join(String(vars[k]));\n    return s;\n  }\n\n  // ------------------------------------------------------------ 和宿主说话\n  var nextId = 1;\n  var pending = {};\n  function send(message) { window.parent.postMessage(message, \"*\"); }\n  function request(method, params, timeoutMs) {\n    var id = nextId++;\n    send({ jsonrpc: \"2.0\", id: id, method: method, params: params || {} });\n    return new Promise(function (resolve, reject) {\n      pending[id] = { resolve: resolve, reject: reject };\n      setTimeout(function () {\n        if (pending[id]) { delete pending[id]; reject(new Error(\"timeout: \" + method)); }\n      }, timeoutMs || 30000);\n    });\n  }\n  function notify(method, params) { send({ jsonrpc: \"2.0\", method: method, params: params || {} }); }\n  function respond(id, result) { send({ jsonrpc: \"2.0\", id: id, result: result }); }\n\n  var handlers = {};\n  window.addEventListener(\"message\", function (event) {\n    if (event.source !== window.parent) return;\n    var m = event.data;\n    if (!m || m.jsonrpc !== \"2.0\") return;\n    if (m.method === undefined && m.id !== undefined) {\n      var p = pending[m.id];\n      if (!p) return;\n      delete pending[m.id];\n      if (m.error) p.reject(new Error(m.error.message || \"error\"));\n      else p.resolve(m.result);\n      return;\n    }\n    if (typeof m.method !== \"string\") return;\n    var handler = handlers[m.method];\n    var result = handler ? handler(m.params || {}) : undefined;\n    if (m.id !== undefined) {\n      if (handler || m.method === \"ping\") respond(m.id, result || {});\n      else send({ jsonrpc: \"2.0\", id: m.id, error: { code: -32601, message: \"Method not found\" } });\n    }\n  });\n\n  function callTool(name, args) {\n    return request(\"tools/call\", { name: name, arguments: args || {} }).then(function (result) {\n      if (result && result.isError) throw new Error(resultText(result) || \"tool error\");\n      return result;\n    });\n  }\n  function resultText(result) {\n    var block = (result && result.content || []).filter(function (c) { return c.type === \"text\"; })[0];\n    return block ? String(block.text) : \"\";\n  }\n\n  // ------------------------------------------------------------ 宿主上下文\n  var context = {};\n  function applyContext(patch) {\n    if (!patch) return;\n    for (var k in patch) context[k] = patch[k]