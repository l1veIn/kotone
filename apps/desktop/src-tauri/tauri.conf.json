{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kotone",
  "version": "0.1.7-rc.4",
  "identifier": "com.l1vein.kotone",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "Kotone Overlay",
        "url": "index.html#/overlay",
        "width": 480,
        "height": 120,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false
      },
      {
        "label": "main",
        "title": "Kotone 设置",
        "url": "index.html#/settings",
        "width": 800,
        "height": 600,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": false,
        "maximizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "l1veIn",
    "category": "Utility",
    "shortDescription": "面向游戏玩家的本地语音输入工具",
    "longDescription": "Kotone（琴音）通过全局热键把语音转换为文字，并发送到游戏聊天框。识别在本机完成，支持英雄联盟术语热词与通用输入配置。",
    "copyright": "Copyright © 2026 l1veIn",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "installer/kotone-installer.nsi",
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "uninstallerHeaderImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzMkM2QzM4RTQ4NkNERApSV1RkYkVpT3c4WXlEbnBTNnFzeHdBclNsTG9BTldma1pnZCthUHdSaTlGQi9pNFNibWp4Tk4yawo=",
      "endpoints": [
        "https://ghfast.top/https://github.com/l1veIn/kotone/releases/latest/download/latest-cn-ghfast.json",
        "https://gh-proxy.com/https://github.com/l1veIn/kotone/releases/latest/download/latest-cn-ghproxy.json",
        "https://ghproxy.net/https://github.com/l1veIn/kotone/releases/latest/download/latest-cn-ghproxynet.json",
        "https://gh.llkk.cc/https://github.com/l1veIn/kotone/releases/latest/download/latest-cn-llkk.json",
        "https://github.com/l1veIn/kotone/releases/latest/download/latest.json"
      ]
    }
  }
}
