{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kotone",
  "version": "0.2.0-rc.7",
  "identifier": "com.l1vein.kotone",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:17420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "plugin-overlay",
        "create": false,
        "title": "Kotone 覆盖层",
        "url": "index.html#/plugin-overlay",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "focusable": false,
        "visible": false
      },
      {
        "label": "danmaku",
        "create": false,
        "title": "Kotone 提醒",
        "url": "index.html#/danmaku",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "focusable": false,
        "visible": false
      },
      {
        "label": "companion",
        "create": false,
        "title": "琴音",
        "url": "index.html#/companion",
        "width": 440,
        "height": 260,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "visible": false,
        "shadow": false,
        "resizable": false
      },
      {
        "label": "overlay",
        "create": false,
        "title": "Kotone Overlay",
        "url": "index.html#/overlay",
        "width": 480,
        "height": 120,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false
      },
      {
        "label": "main",
        "create": false,
        "title": "Kotone 设置",
        "url": "index.html#/settings",
        "width": 1280,
        "height": 820,
        "minWidth": 520,
        "minHeight": 600,
        "decorations": false,
        "maximizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: https://asset.localhost https://*.music.126.net"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "../../../LICENSE": "LICENSE.txt",
      "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../../licenses/codeg-APACHE-2.0.txt": "licenses/codeg-APACHE-2.0.txt",
      "../../../licenses/goose-APACHE-2.0.txt": "licenses/goose-APACHE-2.0.txt",
      "../../../licenses/deepseek-harness-MIT.txt": "licenses/deepseek-harness-MIT.txt",
      "../../../licenses/CC-BY-NC-SA-4.0.txt": "licenses/CC-BY-NC-SA-4.0.txt",
      "../../../licenses/sonora-BSD-3-Clause.txt": "licenses/sonora-BSD-3-Clause.txt",
      "../../../licenses/api-enhanced-MIT.txt": "licenses/api-enhanced-MIT.txt",
      "../../../licenses/ncmapi-MIT.txt": "licenses/ncmapi-MIT.txt",
      "../../../licenses/YesPlayMusic-MIT.txt": "licenses/YesPlayMusic-MIT.txt",
      "../../../licenses/LeagueAkari-MIT.txt": "licenses/LeagueAkari-MIT.txt",
      "../src/assets/roles/README.md": "licenses/role-art.md",
      "../../../docs/third-party/rambledesk-ports.md": "licenses/rambledesk-ports.md"
    },
    "publisher": "l1veIn",
    "category": "Utility",
    "shortDescription": "面向游戏玩家的本地语音输入工具",
    "longDescription": "Kotone（琴音）通过全局热键把语音转换为文字，并发送到游戏聊天框。支持本地或可选在线识别与文字处理；内置的琴音 Agent 能替你看聊天、在游戏里发言、提醒和运行自动化；本地模式支持英雄联盟术语热词与通用输入配置。",
    "copyright": "Copyright © 2026 l1veIn",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "installer/kotone-installer.nsi",
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "uninstallerHeaderImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzMkM2QzM4RTQ4NkNERApSV1RkYkVpT3c4WXlEbnBTNnFzeHdBclNsTG9BTldma1pnZCthUHdSaTlGQi9pNFNibWp4Tk4yawo=",
      "endpoints": [
        "https://kotone-1258931230.cos.ap-guangzhou.myqcloud.com/releases/latest-0.2.json"
      ]
    }
  }
}
