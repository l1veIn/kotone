{
  "identifier": "default",
  "description": "Kotone 默认权限集：覆盖全部窗口",
  "windows": ["main", "overlay"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-start-dragging",
    "core:webview:default",
    "core:event:default",
    "global-shortcut:default"
  ]
}
