{
  "identifier": "default",
  "description": "Kotone 设置主窗口权限集",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:app:default",
    "core:webview:default",
    "core:event:default",
    "global-shortcut:default",
    "dialog:default",
    "updater:default",
    "process:default"
  ]
}
