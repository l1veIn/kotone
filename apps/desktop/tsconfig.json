{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"],
      "$plugins/*": ["../../plugins/*"],
      "svelte": ["./node_modules/svelte"],
      "svelte/*": ["./node_modules/svelte/*"],
      "@lucide/svelte": ["./node_modules/@lucide/svelte"],
      "@tauri-apps/api/*": ["./node_modules/@tauri-apps/api/*"],
      "@tauri-apps/plugin-dialog": ["./node_modules/@tauri-apps/plugin-dialog"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts", "../../plugins/*/ui/**/*.ts", "../../plugins/*/ui/**/*.svelte"]
}
