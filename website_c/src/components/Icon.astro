  replay: `<circle cx="12" cy="12" r="9" /><path d="M10.2 8.2 15 12l-4.8 3.8Z" fill="currentColor" stroke="none" />`,
  shield: `<path d="M12 3 19 5.8V11c0 4.6-3 7.8-7 9.4-4-1.6-7-4.8-7-9.4V5.8Z" /><path d="M8.8 12 11 14.2l4.2-4.4" />`,
